  },
  {
    "id": 184,
    "start": 851.67,
    "end": 852.55,
    "text": "まさか"
  },
  {
    "id": 185,
    "start": 852.55,
    "end": 855.67,
    "text": "この科学が進んだ現代にお化けなんて"
  },
  {
    "id": 186,
    "start": 855.67,
    "end": 857.29,
    "text": "いい加減にしろりょうつ"
  },
  {
    "id": 187,
    "start": 857.29,
    "end": 859.49,
    "text": "大方どっかでサボって遅刻したんで"
  },
  {
    "id": 188,
    "start": 859.49,
    "end": 861.91,
    "text": "それをごまかすための下手な言い訳だろ"
  },
  {
    "id": 189,
    "start": 861.91,
    "end": 862.55,
    "text": "あ"
  },
  {
    "id": 190,
    "start": 862.55,
    "end": 865.61,
    "text": "そういえばゆうべお化け騒動がありましたね"
  },
  {
    "id": 191,
    "start": 865.61,
    "end": 868.71,
    "text": "まさかお前の手話じゃないだろうな"
  },
  {
    "id": 192,
    "start": 868.71,
    "end": 869.57,
    "text": "ちがいます"
  },
  {
    "id": 193,
    "start": 869.57,
    "end": 870.73,
    "text": "ちがいます"
  },
  {
    "id": 194,
    "start": 870.73,
    "end": 873.65,
    "text": "でもわしの話は誓って本当ですよ"
  },
  {
    "id": 195,
    "start": 873.65,
    "end": 875.87,
    "text": "何を寝ぼけてるんだ"
  },
  {
    "id": 196,
    "start": 875.87,
    "end": 877.81,
    "text": "お化けなんかいるわけないだろうが"
  },
  {
    "id": 197,
    "start": 877.81,
    "end": 879.15,
    "text": "もし本当にお化けがあるとはな"
  },
  {
    "id": 198,
    "start": 879.17,
    "end": 882.31,
    "text": "お化けがいるんだら金を払っても見てみたいわい"
