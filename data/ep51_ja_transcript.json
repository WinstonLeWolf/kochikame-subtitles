    "end": 735.48,
    "text": "誰だあんた"
  },
  {
    "id": 152,
    "start": 735.48,
    "end": 737.58,
    "text": "あ駄菓子屋のばあさんか"
  },
  {
    "id": 153,
    "start": 737.58,
    "end": 740.52,
    "text": "そんだけ厚化粧なら視野も見えんな"
  },
  {
    "id": 154,
    "start": 740.52,
    "end": 746.28,
    "text": "ちょっと手の角度が違うな"
  },
  {
    "id": 155,
    "start": 746.28,
    "end": 747.24,
    "text": "このくらいかな"
  },
  {
    "id": 156,
    "start": 751.76,
    "end": 771.44,
    "text": "あんたも参加する必要だったんだ"
  },
  {
    "id": 157,
