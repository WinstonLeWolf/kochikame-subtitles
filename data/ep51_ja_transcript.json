  },
  {
    "id": 161,
    "start": 774.04,
    "end": 778.04,
    "text": "ああもうどうしてどうしてみんなもすごいメイクじゃないか"
  },
  {
    "id": 162,
    "start": 778.04,
    "end": 781.1,
    "text": "とても商店街のお化け大会とは思えんな"
  },
  {
    "id": 163,
    "start": 781.1,
    "end": 785.28,
    "text": "よしわしはあっちの方に隠れるからなたっぷりと脅かしてやろうぜ"
  },
  {
    "id": 164,
    "start": 785.28,
    "end": 788.73,
    "text": "じゃあなちょんべんチビ出してやるからな"
  },
  {
    "id": 165,
